# ten98-monitor — local development environment template.
#
# Generate a real .env with:
#   pnpm run setup:local
# It writes random authentication/database secrets plus an encryption keyring and refuses to
# overwrite an existing .env. NEVER use the placeholder values as-is.
# There is no public/default admin password: the first account created in the
# UI becomes the owner, so create it before exposing the app to anyone else.

APP_URL=http://localhost:3000
APP_PORT=3000

POSTGRES_PASSWORD=replace-with-generated-random-value
AUTH_SECRET=replace-with-generated-random-value

# Provider secrets use a separate persistent AES-256 keyring. setup:local
# generates it for a new install. Existing analytics works without a keyring
# until provider credentials are stored. Back up all keys with the database.
# CREDENTIAL_KEYS accepts a JSON object mapping key names to 32-byte base64 keys;
# CREDENTIAL_KEYS_FILE is the exclusive file-based alternative.
# CREDENTIAL_KEYS={"v1":"<32-byte-base64-key>"}
# CREDENTIAL_ACTIVE_KEY=v1

# Example for local, non-Compose development against a host DB only.
# Placeholders, not a working secret. Compose injects its own internal
# DATABASE_URL (postgres:5432) and ARTIFACT_DIR (/data/artifacts).
DATABASE_URL=postgresql://ten98:replace-with-generated-random-value@localhost:5432/ten98
ARTIFACT_DIR=./data/artifacts

# The container web command (cli.ts start-web) and the worker apply pending migrations before
# serving or working, under one PostgreSQL advisory lock so only one process migrates. Set false
# to migrate explicitly (for example after a backup) with `cli.ts migrate`; web and worker then
# wait up to 5 minutes for the schema and exit non-zero if it is still not current.
# MIGRATE_ON_START=true

# Visitor/visit estimates need a verified network path. Off still counts consented
# page views and events, but leaves visitor identity unavailable. Do not trust
# forwarding headers from arbitrary clients or enable direct mode behind a proxy.
ANALYTICS_NETWORK_MODE=off
# In proxy mode, list only the exact trusted proxy IPs/CIDRs; the peer must match.
# ANALYTICS_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Installation-wide analytics exclusion, like Umami IGNORE_IP: at most 32 IPs/CIDRs,
# matched only against the direct or proxy-resolved address, so client headers never
# trigger it. Behind an edge that appends to a client's X-Forwarded-For, a malformed or
# over-long chain (including a forward proxy's "unknown") leaves the address unknown: counted.
# Refused while ANALYTICS_NETWORK_MODE=off. Restart to apply; not retroactive.
# Shared NAT, CGNAT or VPN ranges exclude other people's traffic too.
# ANALYTICS_EXCLUDED_IPS=203.0.113.0/24,2001:db8::/32

# Reverse proxies whose X-Forwarded-For identifies the client for per-client rate limits
# on sign-in, recovery, OIDC and invitation routes. Unset: ANALYTICS_TRUSTED_PROXIES applies;
# when both are empty, the transport peer is the client.
# Public collection (/api/collect, replay, heatmaps, tracking config) counts a per-client limit
# only when one of these lists is set, or ANALYTICS_NETWORK_MODE=direct. Behind a reverse proxy,
# set TRUSTED_PROXIES or ANALYTICS_TRUSTED_PROXIES to enable it; otherwise only the per-site and
# instance-wide collection limits apply. Direct mode asserts there is NO reverse proxy: enabling
# it behind one makes the proxy's address a single key shared by every visitor.
# List only the exact proxy IPs/CIDRs the app sees (see https://github.com/Ten98-IO-Company/ten98-discover/wiki/Configuration#reverse-proxies).
# TRUSTED_PROXIES=172.18.0.2
# Optional first-party aliases, like Umami COLLECT_API_ENDPOINT/TRACKER_SCRIPT_NAME.
# /api/collect and /tracker.js always keep working. One absolute path each; see https://github.com/Ten98-IO-Company/ten98-discover/wiki/Tracking#first-party-collector-path.
# COLLECT_PATH_ALIAS=/t/e
# TRACKER_SCRIPT_ALIAS=/stats.js

# Instance-wide transactional email. Disabled until explicitly configured.
# Configured does not verify provider entitlement, sender-domain setup or delivery.
# Each send is one bounded attempt; never enable SMTP/provider debug logging.
EMAIL_TRANSPORT=disabled
# EMAIL_FROM=accounts@example.com
# SMTP: authenticated TLS1.2+; starttls (default port587) or tls (default465).
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_TLS=starttls
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=replace-with-smtp-username
# EMAIL_SMTP_PASSWORD=replace-with-smtp-password
# Cloudflare REST: sending-enabled domain/account and Email Sending API token required.
# EMAIL_CLOUDFLARE_ACCOUNT_ID=replace-with-32-hex-account-id
# EMAIL_CLOUDFLARE_API_TOKEN=replace-with-email-sending-token
# Amazon SES v2 (EMAIL_TRANSPORT=ses), signed by @ten98/runtime: a region from its SES allowlist, an IAM key
# limited to ses:SendEmail and a verified EMAIL_FROM identity. The configuration set is optional.
# EMAIL_SES_REGION=eu-west-1
# EMAIL_SES_ACCESS_KEY_ID=replace-with-access-key-id
# EMAIL_SES_SECRET_ACCESS_KEY=replace-with-secret-access-key
# EMAIL_SES_CONFIGURATION_SET=transactional
# Optional bounce/complaint feedback: subscribe <APP_URL>/api/email/ses-feedback (HTTPS) to these SNS
# topics (comma-separated, at most 8) with the topic attribute SignatureVersion=2. Verified hard bounces and
# complaints then block later transactional sends to that address; transient and undetermined bounces never do.
# Suppression is permanent and there is no clear tool yet. The stored value is an unkeyed SHA-256 digest of the
# address, derivable by anyone who knows it, so treat it as personal data. Unset: the route answers 404.
# EMAIL_SES_SNS_TOPIC_ARNS=arn:aws:sns:eu-west-1:123456789012:ses-feedback
# EMAIL_FROM/SMTP_HOST/SMTP_USER/SMTP_PASSWORD/CLOUDFLARE_ACCOUNT_ID/API_TOKEN/SES_ACCESS_KEY_ID/SES_SECRET_ACCESS_KEY
# also accept their exclusive _FILE alternatives. Never set both value and _FILE.
# File paths must be readable inside the app container; use explicit secret mounts.
